<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="confirmation_form" model="ir.ui.view">
        <field name="name">sale.chassis.confirmation.form</field>
        <field name="model">sale.chassis.confirmation</field>
        <field name="arch" type="xml">
            <form string="Retail or Wholesale?">
                <group>
                    <field name="sale_order_id" invisible="not sale_order_id" options="{'no_open': True}"/>
                    <field name="invoice_id" invisible="not invoice_id" options="{'no_open': True}"/>
                    <field name="sale_type" widget="radio" required="1"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="sale_type != 'retail'">
                    Add the chassis number on a separate line below each product name in Description.
                    Example: Chassis Number: ABC123. For several motorcycles, enter their chassis numbers here.
                    Use the existing line description on the document. This description will appear on the sales order, invoice and delivery.
                </div>
                <div class="alert alert-info" role="alert" invisible="sale_type != 'wholesale'">
                    Chassis numbers are optional for wholesale sales.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
