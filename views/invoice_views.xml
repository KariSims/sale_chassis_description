<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_chassis" model="ir.ui.view">
        <field name="name">account.move.chassis.description</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="chassis_sale_type" readonly="state != 'draft'" invisible="move_type not in ['out_invoice', 'out_refund']"/>
            </xpath>
        </field>
    </record>
</odoo>
